# Release-age hold: when npm resolves a version (npm install <pkg>, npm update,
# a re-lock), skip anything published less than a day ago, so a hijacked
# release has time to be spotted and pulled first. `npm ci` still installs
# exactly what package-lock.json pins. npm 10 ignores this setting.
# For a security fix newer than a day: npm install --min-release-age=0 <pkg>@<ver>
min-release-age=1
