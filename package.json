{
  "name": "passflares",
  "version": "1.1.5",
  "description": "A modern and secure password manager built on the Cloudflare Stack.",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:audit": "npm audit --audit-level=moderate",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:stryker": "stryker run",
    "test:all": "npm run typecheck && npm run test:audit && vitest run && playwright test",
    "test:security": "vitest run tests/backend/static-server.test.ts tests/backend/integration tests/guardrails/code-security-invariants.test.ts tests/guardrails/static-security-audit.test.ts tests/backend/vuln-classes.test.ts tests/backend/worker-security.test.ts tests/backend/vendor-integrity.test.ts tests/frontend/keys.test.js tests/frontend/auth-flow.test.js tests/frontend/vault-keys.test.js",
    "test:guardrails": "vitest run tests/guardrails",
    "preflight": "npm run test:all"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "itty-router": "^5.0.24",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.2",
    "qrcode-svg": "^1.1.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
