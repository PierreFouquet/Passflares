{
  "name": "passflares",
  "version": "1.1.4",
  "description": "A modern and secure password manager built on the Cloudflare Stack.",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:audit": "npm audit --audit-level=moderate",
    "test:all": "npm run test:audit && vitest run && playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@playwright/test": "^1.62.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "itty-router": "^5.0.24",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.5.1",
    "qrcode-svg": "^1.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
